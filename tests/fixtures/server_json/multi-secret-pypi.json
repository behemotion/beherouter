{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.example/crm",
  "description": "CRM records over MCP.",
  "version": "0.9.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "crm-mcp",
      "version": "0.9.1",
      "runtimeHint": "uvx",
      "transport": {"type": "stdio"},
      "environmentVariables": [
        {"name": "CRM_URL", "description": "CRM base URL", "isRequired": true, "default": "https://crm.example.com"},
        {"name": "CRM_TOKEN", "description": "API token", "isRequired": true, "isSecret": true},
        {"name": "CRM_SIGNING_KEY", "description": "Webhook signing key", "isRequired": false, "isSecret": true}
      ]
    }
  ]
}
