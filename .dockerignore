# Build-context excludes. KEEP .containerignore AND .dockerignore IDENTICAL:
# podman/buildah read .containerignore, BuildKit (docker/build-push-action, which
# builds the published image) reads only .dockerignore. CI diffs the two.
.venv/
.git/
__pycache__/
.pytest_cache/
*.pyc
data/
registry.toml
.claude/
docs/superpowers/
# Secrets and local state must never reach a layer: `COPY . /app` would bake a
# deploy-time .env (scripts/deploy.sh's default) into the image.
.env
.env.*
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
# Untracked, machine-local material (agent notes, infra briefings) that exists
# only in a working checkout -- never in a clean clone, so never in an image.
local-infra/
.superpowers/
docs/handoffs/
