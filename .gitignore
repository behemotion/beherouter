# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/
env/

# uv
# NOTE: uv.lock is intentionally TRACKED — beherouter is a deployed application,
# not a library, and the container build needs a reproducible resolution
# (uv.lock is the reproducible resolution the Containerfile builds from).

# IDE / OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# secrets / local env
.env
*.local

# beherouter runtime state
data/
registry.toml

# superpowers SDD scratch (ledger, briefs, review packages)
.superpowers/

# Internal working artifacts — not published.
# plans/ are execution checklists with no value to a public reader, and they
# carry 87 of the repo's internal-identifier hits. specs/ ARE published (they
# are the design record) and are scrubbed instead — rewriting a plan to remove
# a hostname would falsify a historical record.
docs/superpowers/plans/
local-infra/


# e2e run artifacts: signed tokens and a generated registry, never committed
tests/e2e/material.json
tests/e2e/registry.toml

# coverage (pytest-cov)
.coverage
.coverage.*
coverage.xml
htmlcov/

# BEHEMOTION operator docs — local only, never committed (CONVENTIONS §11)
/AGENTS.md
/CLAUDE.md
/CONNECTIONS.md
/HANDOFF.md
/HARNESS-DIVERGENCES.md
/docs/handoffs/
/docs/history/
/.claude/
/.opencode/
